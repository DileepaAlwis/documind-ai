# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=documind_ai
MYSQL_USER=documind_user
MYSQL_PASSWORD=change_me

# ---------- Spring Boot ----------
SERVER_PORT=8080
JWT_SECRET=change_me_to_a_random_string_of_at_least_64_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:5173
UPLOAD_DIR=D:/documind-ai/storage/uploads
MAX_UPLOAD_MB=25
AI_SERVICE_URL=http://127.0.0.1:8000
SPRING_INTERNAL_URL=http://127.0.0.1:8080

# ---------- Internal service-to-service key (same value used by both services) ----------
INTERNAL_API_KEY=change_me_to_a_long_random_string

# ---------- FastAPI AI service ----------
AI_HOST=127.0.0.1
AI_PORT=8000
QDRANT_PATH=D:/documind-ai/ai-service/qdrant_storage
QDRANT_COLLECTION=document_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
TOP_K=5
SIMILARITY_THRESHOLD=0.30

# ---------- LLM provider ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=180

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080/api

COOKIE_SECURE=false
